# Server
PORT=8000
NODE_ENV=development
QUEUEKIT_API_HOST_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Redis (required — local Docker Compose or hosted Key Value)
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=queuekit:demo:

# Body / rate limits
BODY_SIZE_LIMIT=16kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Worker (same process on free tier; set RUN_WORKER=false to disable)
RUN_WORKER=true
