# Copied into backend/.env for local API development.
# Railway injects these as service variables (no .env file needed there).

PORT=8000
NODE_ENV=development
QUEUEKIT_API_HOST_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:3000

# Local: docker compose up -d
# Hosted: Railway Redis / Upstash / any Redis-compatible URL
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=queuekit:demo:

BODY_SIZE_LIMIT=16kb

# Global per-IP limit (default: 500 req / 15 min). Health probes are skipped.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Conservative job enqueue limit (default: 20 jobs / 60s per IP)
JOB_RATE_LIMIT_WINDOW_MS=60000
JOB_RATE_LIMIT_MAX=20

# Destructive demo reset limit (default: 5 / 15 min per IP)
RESET_RATE_LIMIT_WINDOW_MS=900000
RESET_RATE_LIMIT_MAX=5

RUN_WORKER=true
